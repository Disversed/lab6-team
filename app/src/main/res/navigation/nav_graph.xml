<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/firstAttractionFragment">

    <fragment
        android:id="@+id/firstAttractionFragment"
        android:name="com.lab6.mikhail.FirstAttractionFragment"
        android:label="@string/ermitage" />
    <fragment
        android:id="@+id/secondAttractionFragment"
        android:name="com.lab6.mikhail.SecondAttractionFragment"
        android:label="@string/peterhof" />
    <fragment
        android:id="@+id/thirdAttractionFragment"
        android:name="com.lab6.mikhail.ThirdAttractionFragment"
        android:label="@string/erarta" />
    <fragment
        android:id="@+id/blankFragment2"
        android:name="com.lab6.dmitry.BlankFragment2"
        android:label="fragment_blank2"
        tools:layout="@layout/fragment_blank2" >
        <action
            android:id="@+id/action_blankFragment2_to_powerFragment"
            app:destination="@id/powerFragment" />
    </fragment>

    <fragment
        android:id="@+id/blankFragment"
        android:name="com.lab6.denis.BlankFragment"
        android:label="fragment_blank"
        tools:layout="@layout/fragment_pushkin" />
    <fragment
        android:id="@+id/powerFragment"
        android:name="com.lab6.dmitry.PowerFragment"
        android:label="fragment_power"
        tools:layout="@layout/fragment_power" >
        <action
            android:id="@+id/action_powerFragment_to_trigonometryFragment"
            app:destination="@id/trigonometryFragment" />
    </fragment>
    <fragment
        android:id="@+id/trigonometryFragment"
        android:name="com.lab6.dmitry.TrigonometryFragment"
        android:label="fragment_trigonometry"
        tools:layout="@layout/fragment_trigonometry" />

