<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/firstAttractionFragment">

    <fragment
        android:id="@+id/firstAttractionFragment"
        android:name="com.lab6.mikhail.FirstAttractionFragment"
        android:label="@string/ermitage" />
    <fragment
        android:id="@+id/secondAttractionFragment"
        android:name="com.lab6.mikhail.SecondAttractionFragment"
        android:label="@string/peterhof" />
    <fragment
        android:id="@+id/thirdAttractionFragment"
        android:name="com.lab6.mikhail.ThirdAttractionFragment"
        android:label="@string/erarta" />
    <fragment
        android:id="@+id/blankFragment2"
        android:name="com.lab6.dmitry.BlankFragment2"
        android:label="fragment_blank2"
        tools:layout="@layout/fragment_blank2" >

    </fragment>

    <fragment
        android:id="@+id/blankFragment"
        android:name="com.lab6.denis.BlankFragment"
        android:label="Портрет"
        tools:layout="@layout/fragment_pushkin">

        <action
            android:id="@+id/action_blankFragment_to_biographyFragment"
            app:destination="@id/biographyFragment"/>

    </fragment>

    <fragment
        android:id="@+id/biographyFragment"
        android:name="com.lab6.denis.BiographyFragment"
        android:label="Биография"
        tools:layout="@layout/fragment_biography">

        <action
            android:id="@+id/action_biographyFragment_to_worksFragment"
            app:destination="@id/worksFragment"/>

    </fragment>

    <fragment
        android:id="@+id/worksFragment"
        android:name="com.lab6.denis.WorksFragment"
        android:label="Произведения"
        tools:layout="@layout/fragment_works"/>


</navigation>