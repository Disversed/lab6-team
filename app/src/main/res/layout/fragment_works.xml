<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Произведения А.С. Пушкина"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Роман в стихах"
            android:textSize="21sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Евгений Онегин"
            android:textSize="18sp"
            android:padding="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Поэмы"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Руслан и Людмила\n• Кавказский пленник\n• Бахчисарайский фонтан\n• Медный всадник"
            android:textSize="18sp"
            android:lineSpacingExtra="8dp"
            android:padding="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Романы и повести"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Капитанская дочка\n• Дубровский\n• Пиковая дама"
            android:textSize="18sp"
            android:lineSpacingExtra="8dp"
            android:padding="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сказки"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Сказка о рыбаке и рыбке\n• Сказка о царе Салтане\n• Сказка о мёртвой царевне и семи богатырях\n• Сказка о золотом петушке"
            android:textSize="18sp"
            android:lineSpacingExtra="8dp"
            android:padding="8dp"/>

    </LinearLayout>

</ScrollView>